<?xml version="1.0" encoding="utf-8"?>
<!--
  QuietQQliu 自适应图标背景：QQ 蓝到深夜蓝的斜向渐变。
  108x108 与 adaptive icon 规范一致；路径铺满画布，由启动器裁切形状。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF2389F0" />
                <item android:offset="0.55" android:color="#FF1450A8" />
                <item android:offset="1" android:color="#FF0A1B33" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 右上角柔光，避免纯渐变太平。 -->
    <path android:pathData="M108,0v54C86,54 70,34 70,0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="104"
                android:centerY="6"
                android:gradientRadius="64">
                <item android:offset="0" android:color="#4028C8FF" />
                <item android:offset="1" android:color="#0028C8FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
