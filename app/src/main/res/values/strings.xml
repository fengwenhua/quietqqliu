    <string name="f_ad_splash_title">开屏广告跳过</string>
    <string name="f_ad_splash_summary">冷/热启动都不再请求、展示 AMS/RMP 开屏广告，直接进入主页</string>
    <string name="f_ad_feed_title">推荐页信息流广告</string>
    <string name="f_ad_feed_summary">移除「推荐」列表中的原生广告卡与优量汇信息流广告</string>
    <string name="f_ad_mine_title">「我的」页面广告</string>
    <string name="f_ad_mine_summary">隐藏「我的」页头像挂件广告与 Banner 广告位</string>
    <string name="f_ad_novel_title">小说阅读广告</string>
    <string name="f_ad_novel_summary">章节内插页、书页广告与书城 Banner 不再展示（参考悦读卡效果）</string>
    <string name="f_ad_listen_title">听书广告</string>
    <string name="f_ad_listen_summary">听书信息流、播放页贴片与章节间音频广告不再插入</string>
    <string name="f_ad_reward_title">激励视频/看广告免广告</string>
    <string name="f_ad_reward_summary">拦截激励视频与「看广告免广告」入口；看广告领奖/解锁会失败</string>
    <string name="f_ad_preload_title">广告预加载断源</string>
    <string name="f_ad_preload_summary">开屏与信息流不再后台预加载广告，减少流量与首屏等待</string>
    <string name="f_ad_shake_title">摇一摇跳转禁用</string>
    <string name="f_ad_shake_summary">广告不再注册摇一摇/扭转传感器，避免误触跳转</string>
    <string name="f_ad_popup_title">弹窗/插屏广告</string>
    <string name="f_ad_popup_summary">拦截 H5 与页面触发的广告弹窗、插屏和免广告提示</string>
    <string name="f_ad_download_unlock_title">下载看广告解锁</string>
    <string name="f_ad_download_unlock_summary">小说/网页点「看广告下载」时不放广告，直接回传广告完成，继续下载</string>
    <string name="f_ad_hippy_title">Hippy 页面广告</string>
    <string name="f_ad_hippy_summary">拦截小说阅读页、推荐、短剧等 Hippy 页面的广告取数与 getAds 请求（含底部/插页广告）</string>
    <string name="f_ad_vip_title">模拟悦读卡（免广告）</string>
    <string name="f_ad_vip_summary">本地模拟悦读卡已开通 99 年：阅读页不再取广告，点下载直接开始（不解锁付费章节）</string>
    <string name="f_ad_mask_pendant_title">热启动全屏/悬浮广告</string>
    <string name="f_ad_mask_pendant_summary">拦截热启动后的全屏倒计时广告，以及倒计时结束缩到右下角的悬浮挂件</string>

    <!-- 界面精简 -->
